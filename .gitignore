# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Python-generated script caches
__pycache__/
*.py[cod]

# Machine-local MCP dependencies and executable paths.
/Tools/MCP/
/.codex/config.toml

# Blender automatic backups; keep the editable .blend sources.
*.blend[0-9]

# Ignore whole external packs; only selected runtime dependencies are force-added.
# Tracked files from Config/RuntimeAssets.json remain tracked despite these rules.
# Source attribution and license terms are documented in RUNTIME_ASSETS.md.
# Reproducible Fab Marketplace content (Warehouse)
/Content/Scene_Warehouse/
/Content/Warehouse/Collision/
/Content/Warehouse/Physics/
/Content/__ExternalActors__/Scene_Warehouse/
/Content/__ExternalObjects__/Scene_Warehouse/

# Exclude unused Fab exterior content; selected dependencies are tracked.
/Content/GV_FreeShrubsPack/
/Content/VehicleVarietyPack/
/Content/EuropeanBeech/
/Content/MSPresets/

# Rebuild intermediate FBX imports; source FBX and final AGV rig assets are tracked.
/Content/Warehouse/AGV/SourceMeshes/

# Keep source downloads local; track only selected imported runtime files.
/SourceAssets/Cargo/BoxesPalletsPack/
/Content/Warehouse/Cargo/BoxesPalletsPack/

# Rebuild original FBX import; final original rig/materials remain tracked.
/Content/Warehouse/AGV/OriginalSource/

# Rebuild refined model intermediate imports from the tracked FBX.
/Content/Warehouse/AGV/RefinedSource/

# Track only selected truck derivatives, not every generated variant.
/Content/Warehouse/Exterior/TruckInterior/

# Track selected runtime motions; unused imported sample content stays local.
/Content/Warehouse/AnimationSample/
/Content/Characters/UE5_Mannequins/

# Track selected observer wall variants; unused generated variants stay local.
/Content/Warehouse/Materials/ObserverWalls/

# Local repeatable experiment fixtures; source test scripts recreate these maps.
/Content/__ExperimentTests/
